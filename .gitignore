# Build output: regenerated by `node pack.mjs` (and by every scan), so it is
# never worth a commit. Each workflow run attaches its own copy as an artifact.
dist/

node_modules/
.DS_Store
Thumbs.db

# Secrets: never commit. The RobinReach key grants full control of the
# connected social accounts, including publishing.
.robinreach.key
*.key
.env
.env.*
